PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Local: mongodb://localhost:27017/ai-creator-dashboard
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-creator-dashboard?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ai-creator-dashboard

# YouTube Data API v3 Key
# Get this from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# Gemini API Key
# Get this from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Security Key for JWT (If implemented later)
JWT_SECRET=super_secret_key_change_in_production
